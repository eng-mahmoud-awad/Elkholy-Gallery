generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type Image {
  url      String
  publicId String // لحذف الصورة من Cloudinary لاحقًا
}

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  kind     String    @default("sofa") // bed | dining | sofa | kids (للصور البديلة فقط)
  order    Int       @default(0)
  products Product[]
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  dimensions  String?
  material    String?
  color       String?
  price       Float?
  images      Image[]
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.ObjectId

  @@index([categoryId])
}

model Settings {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  whatsappNumber String
  aboutText      String
  logoUrl        String?
}
